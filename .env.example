# ==============================================================================
# VeriNews Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production environment.
# NEVER commit .env to version control or expose secret credentials in logs.
# ==============================================================================

# Application Environment
# Options: development, test, production
VERINEWS_ENV=development

# Database Connection URL (PostgreSQL with psycopg 3 binary driver)
# Note: In development and test, SQLite fallback or local PostgreSQL can be used.
# Production requires an approved, SSL-enabled PostgreSQL instance (e.g. Neon).
# Example: postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@ep-example.region.neon.tech/verinews?sslmode=require

# CORS Allowed Origins
# Comma-separated list of trusted client origins.
VERINEWS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Machine Learning Inference Feature Flags
# ==============================================================================
# SAFETY INVARIANT: By default, all model inference is DISABLED (HTTP 503).
# VeriNews NEVER generates synthetic, random, or unverified predictions.
#
# Supported environment variable names:
#   VERINEWS_ENABLE_ENGLISH_INFERENCE (preferred) or ENABLE_ENGLISH_INFERENCE
#   VERINEWS_ENABLE_HINDI_INFERENCE (preferred) or ENABLE_HINDI_INFERENCE
#
# Set to 'true' or '1' only after mentor approval and when calibrated artifacts exist.
VERINEWS_ENABLE_ENGLISH_INFERENCE=false
VERINEWS_ENABLE_HINDI_INFERENCE=false

# Default Model Artifact Names and Storage Directory
# Supported environment variable names:
#   VERINEWS_DEFAULT_ENGLISH_ARTIFACT or DEFAULT_ENGLISH_ARTIFACT
#   VERINEWS_DEFAULT_HINDI_ARTIFACT or DEFAULT_HINDI_ARTIFACT
#   VERINEWS_MODELS_DIR or MODELS_DIR (optional custom directory; defaults to repo models/)
VERINEWS_DEFAULT_ENGLISH_ARTIFACT=en_ifnd_indian_headlines_calibrated_sigmoid.joblib
VERINEWS_DEFAULT_HINDI_ARTIFACT=hi_tallip_hindi_articles_calibrated_sigmoid.joblib
# VERINEWS_MODELS_DIR=models

# ==============================================================================
# Rate Limiting & Proxy Configuration
# ==============================================================================
# The built-in sliding-window rate limiter enforces 60 requests/minute per client IP.
# In production behind a reverse proxy (Nginx, Caddy, Cloudflare, ALB), run Uvicorn
# with --proxy-headers and --forwarded-allow-ips to ensure the true client IP is used.

